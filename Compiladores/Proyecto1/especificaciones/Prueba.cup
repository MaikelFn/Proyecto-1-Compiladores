import java_cup.runtime.*;
parser code {:
    public void syntax_error(Symbol s) {
        System.err.println("Error sintactico en linea " + (s.left + 1));
    }
:};
terminal Integer NUMERO;
terminal MAS, PUNTOCOMA;
non terminal Integer expr;
start with expr;
expr ::= NUMERO:a MAS NUMERO:b PUNTOCOMA
         {: RESULT = a + b; :}
         ;
